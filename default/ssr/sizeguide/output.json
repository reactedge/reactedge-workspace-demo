{"html":"<div class=\"reactedge-sizeguide\"><div class=\"sizeguide-launcher\"><button class=\"sizeguide__open-button\" type=\"button\" aria-haspopup=\"dialog\" style=\"--sizeguide-accent:#45afd1\" data-sizeguide-open=\"true\">Size guide</button><dialog class=\"sizeguide__dialog\" aria-labelledby=\"sizeguide-title\" data-sizeguide-dialog=\"true\"><button class=\"sizeguide__close-button\" type=\"button\" aria-label=\"Close size guide\" data-sizeguide-close=\"true\"><span aria-hidden=\"true\">×</span></button><section class=\"sizeguide\" aria-labelledby=\"sizeguide-title\"><header class=\"sizeguide__header\"><div><p class=\"sizeguide__product-type\">Women&#x27;s clothing</p><h1 id=\"sizeguide-title\" class=\"sizeguide__title\" data-sizeguide-title=\"true\" style=\"color:#20365c\">Women&#x27;s size guide</h1><p class=\"sizeguide__description\">Compare the size labels used in different countries and check garment measurements.</p></div><div class=\"sizeguide__controls\"><label class=\"sizeguide__country-label\" for=\"sizeguide-country\">Country or region</label><select id=\"sizeguide-country\" class=\"sizeguide__country-select\" data-sizeguide-country=\"true\"><option value=\"GB\">🇬🇧 <!-- -->United Kingdom</option><option value=\"US\">🇺🇸 <!-- -->United States</option><option value=\"FR\" selected=\"\">🇫🇷 <!-- -->France</option><option value=\"EU\">🇪🇺 <!-- -->European Union</option></select><div class=\"sizeguide__unit-control\" aria-label=\"Measurement units\"><span class=\"is-selected\">cm</span><button class=\"sizeguide__unit-toggle\" type=\"button\" role=\"switch\" aria-checked=\"false\" aria-label=\"Toggle inches and centimetres\" data-sizeguide-unit-toggle=\"true\" style=\"--sizeguide-accent:#45afd1\"><span></span></button><span class=\"\">in</span></div></div></header><div class=\"sizeguide__table-scroll\"><table class=\"sizeguide__table\"><caption class=\"sizeguide__visually-hidden\">Women&#x27;s size guide<!-- --> for <!-- -->France</caption><thead><tr><th scope=\"col\">Size</th><th scope=\"col\">XXS</th><th scope=\"col\">XS</th><th scope=\"col\">S</th><th scope=\"col\">M</th><th scope=\"col\">L</th><th scope=\"col\">XL</th><th scope=\"col\">XXL</th></tr></thead><tbody><tr class=\"sizeguide__country-sizes\"><th scope=\"row\">France<!-- --> size</th><td>34</td><td>36</td><td>38</td><td>40</td><td>42</td><td>44</td><td>46</td></tr><tr class=\"\"><th scope=\"row\">Bust<!-- --> <span>(<!-- -->cm<!-- -->)</span></th><td>78</td><td>81</td><td>86</td><td>91.5</td><td>96.5</td><td>101.5</td><td>106.5</td></tr><tr class=\"is-shaded\"><th scope=\"row\">Waist<!-- --> <span>(<!-- -->cm<!-- -->)</span></th><td>66</td><td>68.5</td><td>71</td><td>76</td><td>81</td><td>86</td><td>91.5</td></tr><tr class=\"\"><th scope=\"row\">Hips<!-- --> <span>(<!-- -->cm<!-- -->)</span></th><td>86.5</td><td>91.5</td><td>96.5</td><td>101.5</td><td>106.5</td><td>111.5</td><td>117</td></tr><tr class=\"is-shaded\"><th scope=\"row\">Inside leg<!-- --> <span>(<!-- -->cm<!-- -->)</span></th><td>72.5</td><td>74</td><td>76</td><td>77</td><td>77.5</td><td>79</td><td>79.5</td></tr><tr class=\"\"><th scope=\"row\">Sleeve/shoulder<!-- --> <span>(<!-- -->cm<!-- -->)</span></th><td>73</td><td>74.5</td><td>76</td><td>77.5</td><td>79</td><td>80</td><td>81</td></tr></tbody></table></div><div class=\"sizeguide__how-to\"><div class=\"sizeguide__instruction-list\"><h2>How to take your measurements</h2><section class=\"sizeguide__instruction\"><h3>Sleeve/shoulder</h3><p>Measure from the side of your neck, across the shoulder, to just past your wrist bone.</p></section><section class=\"sizeguide__instruction\"><h3>Chest/bust</h3><p>Measure around the fullest part of your chest, keeping the tape level under your arms.</p></section><section class=\"sizeguide__instruction\"><h3>Waist</h3><p>Measure around your natural waist, usually the narrowest part of your torso.</p></section><section class=\"sizeguide__instruction\"><h3>Hips</h3><p>Stand with your feet together and measure around the fullest part of your hips.</p></section><section class=\"sizeguide__instruction\"><h3>Inside leg</h3><p>Measure from the top of your inner thigh down to your ankle.</p></section></div></div></section></dialog></div></div>"}